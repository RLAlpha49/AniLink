flowchart TD
    A([Send request]) --> B{Response}
    B -- success --> C([Return result]):::ok
    B -- failure --> D{Retryable?
status in retryOnStatus
or network error}
    D -- no --> E([Throw last error]):::err
    D -- yes --> F{Attempts left?
attempt <= maxRetries}
    F -- no --> E
    F -- yes --> G{Circuit open?}
    G -- yes --> H([Throw CIRCUIT_OPEN_ERROR]):::err
    G -- no --> I[Compute backoff
full jitter]
    I --> J{AbortSignal
aborted?}
    J -- yes --> K([Throw ABORTED_ERROR]):::err
    J -- no --> L[Wait nextDelayMs]
    L --> A

    classDef ok fill:#d5e8d4,stroke:#82b366,color:#2d5016;
