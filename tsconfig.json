{
    "compilerOptions": {
        "target": "ES2024",
        "module": "esnext",
        "moduleResolution": "bundler",
        "outDir": "./dist",
        "rootDir": "./src",
        "lib": ["ES2024"],
        "strict": true,
        "esModuleInterop": true,
        "types": ["node"],
        "declaration": true,
        "declarationMap": true
    },
    "include": ["src/**/*.ts", "./src"],
    "exclude": ["node_modules", "__tests__", "docs"]
}
