{
  "compilerOptions": {
    "allowJs": true,
    "target": "ES2022",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "./src",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "./src"
  ],
  "exclude": [
    "node_modules",
    "__tests__",
    "docs"
  ]
}