{
  "out": "./docs",
  "entryPoints": ["./src"],
  "entryPointStrategy": "expand",
  "exclude": ["**/__tests__/**"],
  "name": "AniLink",
  "readme": "README.md",
  "plugin": [
    "typedoc-github-theme",
    "typedoc-plugin-mdn-links",
    "typedoc-plugin-missing-exports",
    "typedoc-plugin-llms-txt",
    "typedoc-plugin-ga",
    "@boneskull/typedoc-plugin-mermaid",
  ],
  "tsconfig": "./tsconfig.json",
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeExternals": true,
  "includeVersion": true,
  "hostedBaseUrl": "https://rlalpha49.github.io/AniLink/",
  "useHostedBaseUrlForAbsoluteLinks": true,
  "gaID": "G-F7DE9Y757W",
  "mermaidSource": "cdn"
}