# Tokens used by the integration tests (__tests__/integration) and the
# library. The token CLIs below write these automatically.
ANILIST_TOKEN=
MAL_TOKEN=

# OAuth app credentials read and written by the token CLIs
# (npm run anilist:token / npm run mal:token). Only needed to run the flows.
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
ANILIST_REDIRECT_URI=
ANILIST_REFRESH_TOKEN=
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
MAL_REFRESH_TOKEN=
