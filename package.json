{
  "name": "anilink-api-wrapper",
  "version": "1.29.2",
  "description": "API wrapper for AniManga sites such as Anilist, MyAnimeList, Kitsu.",
  "main": "dist/AniLink.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:coverage": "vitest run --coverage",
    "build": "rimraf dist && tsc",
    "anilist:api:compare": "tsx scripts/anilist-api-compare/cli.ts compare",
    "anilist:api:update-schema": "tsx scripts/anilist-api-compare/cli.ts update-schema",
    "jsdoc:check": "tsx scripts/check-jsdoc.ts",
    "lint": "eslint \"src/**/*.ts\" \"__tests__/**/*.ts\" scripts/",
    "lint:fix": "eslint --fix \"src/**/*.ts\" \"__tests__/**/*.ts\" scripts/",
    "format": "prettier --write \"src/**/*.ts\" \"__tests__/**/*.ts\" scripts/",
    "format:check": "prettier --check \"src/**/*.ts\" \"__tests__/**/*.ts\" scripts/",
    "docs:generate": "typedoc --entryPoints ./src --entryPointStrategy expand --out docs --plugin typedoc-theme-hierarchy --theme hierarchy && node add-ga.js",
    "docs:serve": "npm run docs:generate && npx serve docs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "anilist",
    "myanimelist",
    "kitsu",
    "api",
    "wrapper",
    "anilist-api",
    "anilist-query",
    "anilist-mutation",
    "anilist-graphql"
  ],
  "author": "RLAlpha49",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-promise": "^7.3.0",
    "graphql": "^17.0.2",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.12",
    "typedoc": "^0.28.20",
    "typedoc-theme-hierarchy": "^6.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "axios": "^1.19.0"
  }
}
