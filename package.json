{
  "name": "anilink-api-wrapper",
  "version": "1.29.2",
  "description": "API wrapper for AniManga sites such as Anilist, MyAnimeList, Kitsu.",
  "main": "dist/AniLink.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "rimraf dist && tsc",
    "lint": "eslint \"src/**/*.ts\" \"__tests__/**/*.ts\"",
    "lint:fix": "eslint --fix \"src/**/*.ts\" \"__tests__/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"__tests__/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"__tests__/**/*.ts\"",
    "docs:generate": "typedoc --entryPoints ./src --entryPointStrategy expand --out docs --plugin typedoc-theme-hierarchy --theme hierarchy && node add-ga.js",
    "docs:serve": "npm run docs:generate && npx serve docs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "anilist",
    "myanimelist",
    "kitsu",
    "api",
    "wrapper",
    "anilist-api",
    "anilist-query",
    "anilist-mutation",
    "anilist-graphql"
  ],
  "author": "RLAlpha49",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.6.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.0.1",
    "typedoc": "^0.28.20",
    "typedoc-theme-hierarchy": "^6.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "axios": "^1.7.7"
  }
}
