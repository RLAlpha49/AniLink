{
    "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
    "concurrency": 4,
    "reporters": ["html", "clear-text", "progress"],
    "testRunner": "vitest",
    "coverageAnalysis": "perTest",
    "disableTypeChecks": false,
    "mutate": [
        "src/base/**/*.ts",
        "src/apis/graphql/anilist/Paginator.ts",
        "src/apis/graphql/anilist/auth.ts",
        "src/apis/graphql/anilist/schemas/selection/**/*.ts",
        "!src/apis/graphql/anilist/schemas/selection/fieldsSelection.ts",
        "src/apis/rest/mal/tokenRefresh.ts",
        "src/apis/rest/mal/auth.ts",
        "!src/**/*.d.ts",
        "!src/**/interfaces/**/*.ts",
        "!src/**/types/**/*.ts",
        "!src/**/types.ts",
        "!src/**/index.ts"
    ],
    "vitest": {
        "configFile": "vitest.config.mts",
        "related": false
    },
    "thresholds": {
        "high": 80,
        "low": 60,
        "break": 50
    },
    "ignoreStatic": true
}
