# patch-package patch for @stryker-mutator/vitest-runner 10.0.0.
#
# Hunks and why they exist:
#
# 1. stryker-setup.js and test-helpers.js: collectTestName joins suite parts
#    with " > " instead of " ". Vitest 5 matches testNamePattern against the
#    full suite chain joined with " > ", so the runner's space-joined names made
#    the per-test filter match zero tests; every covered mutant then ran no
#    tests and was reported Survived.
# 2. vitest-test-runner.js: wrap the debug log of the final Vitest config in
#    try/catch, because JSON.stringify throws when the config contains
#    non-serializable values.
#
# Upstream tracking (all open as of 2026-09-18):
#   https://github.com/stryker-mutator/stryker-js/issues/6210
#   https://github.com/stryker-mutator/stryker-js/pull/6214
#   https://github.com/stryker-mutator/stryker-js/pull/6220
# No release ships the fix yet (latest is 10.0.0). Drop this patch once a
# release includes it; the config-log guard has no upstream issue, so verify
# it separately before dropping that hunk.
#
# Regeneration procedure after bumping the runner (including dependabot
# bumps): see "Patched dependencies" in CONTRIBUTING.md.
#
# patch-package ignores these leading comment lines when applying the patch.
diff --git a/node_modules/@stryker-mutator/vitest-runner/dist/src/stryker-setup.js b/node_modules/@stryker-mutator/vitest-runner/dist/src/stryker-setup.js
index aecfacb..bbb824c 100644
--- a/node_modules/@stryker-mutator/vitest-runner/dist/src/stryker-setup.js
+++ b/node_modules/@stryker-mutator/vitest-runner/dist/src/stryker-setup.js
@@ -63,7 +63,7 @@ function collectTestName({ name, suite, }) {
         nameParts.unshift(currentSuite.name);
         currentSuite = currentSuite.suite;
     }
-    return nameParts.join(' ').trim();
+    return nameParts.join(' > ').trim();
 }
 function toRawTestId(test) {
     return `${test.file?.filepath ?? 'unknown.js'}#${collectTestName(test)}`;
diff --git a/node_modules/@stryker-mutator/vitest-runner/dist/src/test-helpers.js b/node_modules/@stryker-mutator/vitest-runner/dist/src/test-helpers.js
index 56cc786..2cd9786 100644
--- a/node_modules/@stryker-mutator/vitest-runner/dist/src/test-helpers.js
+++ b/node_modules/@stryker-mutator/vitest-runner/dist/src/test-helpers.js
@@ -8,7 +8,7 @@ export function collectTestName({ name, suite, }) {
         nameParts.unshift(currentSuite.name);
         currentSuite = currentSuite.suite;
     }
-    return nameParts.join(' ').trim();
+    return nameParts.join(' > ').trim();
 }
 export function toRawTestId(test) {
     return `${test.file?.filepath ?? 'unknown.js'}#${collectTestName(test)}`;
diff --git a/node_modules/@stryker-mutator/vitest-runner/dist/src/vitest-test-runner.js b/node_modules/@stryker-mutator/vitest-runner/dist/src/vitest-test-runner.js
index 84f1ca0..9e92c47 100644
--- a/node_modules/@stryker-mutator/vitest-runner/dist/src/vitest-test-runner.js
+++ b/node_modules/@stryker-mutator/vitest-runner/dist/src/vitest-test-runner.js
@@ -92,7 +92,12 @@ export class VitestTestRunner {
             project.config.browser.screenshotFailures = false;
         });
         if (this.log.isDebugEnabled()) {
-            this.log.debug(`vitest final config: ${JSON.stringify(this.ctx.config, null, 2)}`);
+            try {
+                this.log.debug(`vitest final config: ${JSON.stringify(this.ctx.config, null, 2)}`);
+            }
+            catch {
+                this.log.debug('vitest final config: (not serializable)');
+            }
         }
     }
     async dryRun(options) {
